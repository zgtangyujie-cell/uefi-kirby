--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -713,8 +713,27 @@
 	/*
 	 * This will start displaying progress to the user, start as early as possible
 	 */
+	/*
+	 * kirby: ask for the text console before the screen is acquired.
+	 *
+	 * initialize_screen(NULL, kPEAcquireScreen) computes
+	 *     graphics_now = gc_graphics_boot && !gc_desire_text
+	 * and then calls gc_enable(!graphics_now).  This board is handed a
+	 * graphics framebuffer by the firmware, so gc_graphics_boot is TRUE, and
+	 * with gc_desire_text still FALSE the acquire runs gc_enable(FALSE): it
+	 * sets disableConsoleOutput and gc_enabled = FALSE.  vcputc_options then
+	 * returns before drawing a single character, which is why a kernel that
+	 * is running perfectly well shows nothing at all on the panel.
+	 *
+	 * kPETextScreen while gc_acquired is still FALSE only sets
+	 * gc_desire_text and returns, so the acquire below takes the
+	 * graphics_now == FALSE path and leaves the text console enabled.  No
+	 * new code path, no register poking, no fixed address: it reuses the
+	 * switch XNU already provides for exactly this transition.
+	 */
+	initialize_screen(NULL, kPETextScreen);
 	initialize_screen(NULL, kPEAcquireScreen);
 
 	/*
 		Initialize the shared region module.
 	 */
