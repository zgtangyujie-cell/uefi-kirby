# Board patch paths, one per line in application order.
# kirby-ufs: a BSD bdevsw UFS root driver (ported from UniXNU-kebab, SM8250 ->
# SM8650). It reads the controller window from the ADT /kirby-ufs node and
# exposes LUN 0's "userdata" GPT partition as ufsroot0, so IOFindBSDRoot can
# return it for rd=ufsroot0. Read-only unless boot-arg ufsrw=1.
kirby-ufs.patch
# QcomXnuUsbDebug darwin23 (XNU 10063.141.1): USB CDC-ACM debug console.
# 0001 = pe_kprintf/kprintf/printf/debug/serial_console/serial_general hooks,
#        rewritten so the pe_kprintf.c hunk no longer needs zzz-boot-progress
#        (kernel.yml drops that patch from the OS series).
# 0002 = bsd_init.c worker thread behind qcom-usb-debug=1.
0001-qcom-usb-debug-console.patch
0002-qcom-usb-debug-worker.patch
# 0003 = arm_init: call PE_create_console() before
#        kernel_startup_initialize_upto(STARTUP_SUB_KPRINTF).  It used to
#        run at line 577, i.e. after the KPRINTF chain and after the
#        kprintf at line 537, so nothing the kernel printed could ever
#        reach the panel and initialize_screen() itself never ran.
0003-early-console.patch
