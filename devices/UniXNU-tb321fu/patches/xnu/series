# Board patch paths, one per line in application order.
# kirby-ufs: a BSD bdevsw UFS root driver (ported from UniXNU-kebab, SM8250 ->
# SM8650). It reads the controller window from the ADT /kirby-ufs node and
# exposes LUN 0's "userdata" GPT partition as ufsroot0, so IOFindBSDRoot can
# return it for rd=ufsroot0. Read-only unless boot-arg ufsrw=1.
kirby-ufs.patch
# QcomXnuUsbDebug darwin23 (XNU 10063.141.1): USB CDC-ACM debug console.
# 0001 = pe_kprintf/kprintf/printf/debug/serial_console/serial_general hooks,
#        rewritten so the pe_kprintf.c hunk no longer needs zzz-boot-progress
#        (kernel.yml drops that patch from the OS series).
# 0002 = bsd_init.c worker thread behind qcom-usb-debug=1.
0001-qcom-usb-debug-console.patch
0002-qcom-usb-debug-worker.patch
# kPEAcquireScreen keeps the text console enabled. Without it a graphics boot
# sets gc_graphics_boot TRUE, graphics_now TRUE, and gc_enable(FALSE) leaves
# vcputc shut forever; that is arm_init's console_mode patch, not this series.
#
# 0003 = vcputc_options: drop the two cursor calls.  Evidence it is needed:
# with v_display = 1 the gate stays shut and the board lives 142.1 s; with
# v_display = 0 the gate opens and the board resets at 78.9 s.  Same kernel
# sha256 5d6725ccdd2cedf84af92563 in both images, so the gate word is the only
# variable.  Inside the gate the first action is gc_hide_cursor, which is
# vc_reverse_cursor doing `where[col] = ~where[col]` on vinfo.v_baseaddr
# (video_console.c:1710-1726) -- a read-modify-write on the framebuffer before
# any character is emitted.  Removing those two calls keeps gc_putchar, so text
# still paints and the cursor blink (irrelevant to bring-up) does not.
0003-vcputc-no-cursor.patch
