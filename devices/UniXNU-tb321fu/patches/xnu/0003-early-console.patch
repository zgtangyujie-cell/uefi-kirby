--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -534,6 +534,22 @@
 	/* Setup debugging output. */
 	const unsigned int serial_exists = serial_init();
 	kernel_startup_initialize_upto(STARTUP_SUB_KPRINTF);
+	/* (BRINGUP) Install the video console here, immediately after the KPRINTF
+	 * startup chain and before the first kprintf, instead of at line 577.
+	 * PE_init_kprintf (STARTUP(KPRINTF, STARTUP_RANK_FIRST), pe_kprintf.c:72)
+	 * runs inside the chain above and is what assigns PE_kputc, so before it
+	 * PE_kputc is still NULL and disable_serial_output is still TRUE -- the
+	 * reason initialize_screen()'s own `initialize_screen: b=...` line and the
+	 * first kprintf never appeared even once the console had been installed.
+	 * Measured 2026-11-09 on image 5525625: the panel went black between 47 s
+	 * and 78 s, i.e. vc_init() did clear the screen, but not one character was
+	 * drawn afterwards.  PE_state.video is filled by PE_init_platform() at line
+	 * 371 and its v_baseAddr carries bit 0 from DarwinBoot (panel: written:/n	 * D5100001 1900 640 A00 20 = 0xD5100000, 0x1900 row bytes, 0x640 wide,
+	 * 0xA00 high, 0x20 bpp), so initialize_screen() maps the framebuffer with
+	 * ml_io_map exactly as it would at line 577; the only difference is that
+	 * arm_vm_init() at line 522 has already run.  check_for_panic_log() returns
+	 * early without embedded-panic-log-size, so gPanicBase stays 0. */
+	PE_create_console();
 	kprintf("kprintf initialized\n");
 
 	serialmode = 0;
@@ -574,7 +590,7 @@
 		(void)switch_to_serial_console(); /* Switch into serial mode from video console */
 		disableConsoleOutput = FALSE;     /* Allow printfs to happen */
 	}
-	PE_create_console();
+	/* PE_create_console(); -- moved above, right after the KPRINTF chain */
 
 	/* setup console output */
 	PE_init_printf(FALSE);
