 		VCPUTC_LOCK_LOCK();
 		if (gc_enabled) {
-			gc_hide_cursor(gc_x, gc_y);
+			/*
+			 * (BRINGUP) cursor invert disabled.  gc_hide_cursor and gc_show_cursor
