# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# y and n are 1 and 0, a quoted string or a number is passed through, {tree} is the build tree.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_NATIVE_UFS is not set —— 存储走 patches/xnu/kirby-ufs.patch 的
# BSD bdevsw 驱动，不是 ShengUfs 组件，所以这个开关保持关闭。
#
# 覆盖 profiles/os/ipados-17.7.11-21H461/configs/ipados.config 里的
# CONFIG_XNU_SOURCE_MOCKFS=y（defconfig 拼在 fragments 之后，后写的生效，
# 见 scripts/unixnu/cli.py:120-132）。
# mockfs 是「最小可执行根文件系统」的离线测试夹具，这台机器不需要。
# 而 build-xnu-4k-baseline.sh:244-260 只给 vfs_conf.o 单独加 -DMOCKFS=1，
# mockfs 的实现体来自 build-mockfs-fixture.py 打的 libmockfs_fixture.a，
# 这个归档在 CI 上时而链得上、时而链不上（两轮成功、两轮倒在
# "mockfs_mountroot / mockfs_vfsops / mockfs_vnodeop_opv_desc" 未定义）。
# 关掉它，把这条不稳定的链接路径整条去掉。
# CONFIG_XNU_SOURCE_MOCKFS is not set

# Component recipes and auxiliary archives are only built when this is on; without
# it build_archives() returns immediately and the GopFramebuffer / boot-progress
# archives would silently never be produced.  sheng_defconfig:1 sets it.
CONFIG_XNU_BUILD_ARCHIVES=y

#
# Display backend, following the official guide (/zh/porting/display) and the
# reference device sheng (SM8550, configs/sheng_defconfig:16-22):
#
#   CONFIG_XNU_BOOT_PROGRESS=y          the 48x120 diagnostic page drawn on the
#                                       XNU framebuffer; level 1 freezes after
#                                       30 s of no progress, level 2 keeps running
#   CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y  GopFramebuffer's legacy backend, which
#                                       takes the framebuffer from
#                                       PE_current_console (NativeLegacyDisplay.cpp:293)
#   CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n  the newer MobileFramebuffer path; off for
#                                       iOS 17 across both boards
#
# Until now neither switch existed here, so the kernel had no display backend at
# all and PE_current_console returned nothing to register - which is the real
# reason the panel stayed blank, not the console hacks.
#
# The switches alone only compile the support in; the archives that provide the
# actual entry points still have to be wired (build-boot-progress.py and
# build-gop-legacy-display.py, as sheng board.toml does).  Two stages on purpose:
# this commit measures whether the switches break the build, then the archives
# follow.
#
# Corrected against the same-SoC reference, not the one that was easiest to find.
#
# 5b8f19c copied sheng (SM8550, iPadOS) which uses LEGACY.  caihong is the right
# comparison for this board: same SM8650, same iPadOS 17 profile, and already
# verified, and its configs/caihong_defconfig:26-29 says the opposite:
#
#   CONFIG_XNU_BOOT_PROGRESS=n
#   CONFIG_XNU_BUILD_ARCHIVES=y
#   CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
#   CONFIG_XNU_NATIVE_MOBILE_DISPLAY=y
#
# So mobile display it is.  Its archive recipe is a plain device script that
# exists (UniXNU-caihong/scripts/build-native-mobile-display.py, 14 KB) and its
# implementation is one file, kits/caihong/MobileDisplayProviderProbe.cpp - far
# smaller than the LEGACY path's 28 KB ABI-bound builder.
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=y
