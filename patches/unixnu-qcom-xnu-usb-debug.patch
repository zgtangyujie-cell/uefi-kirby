diff --git a/scripts/build-xnu-4k-baseline.sh b/scripts/build-xnu-4k-baseline.sh
index 8f9d3cf..f8bcef5 100755
--- a/scripts/build-xnu-4k-baseline.sh
+++ b/scripts/build-xnu-4k-baseline.sh
@@ -271,6 +271,24 @@ if [ -d "$MOCKFS_OBJECT_DIR" ]; then
 fi
 EXTRA_MAKE_ARGS+=("ubc_subr.o_CFLAGS_ADD=-DXNU_NATIVE_CS_HASH_CACHE=$CS_HASH_CACHE_MODE")
 EXTRA_CFLAGS=${XNU_EXTRA_CFLAGS:--Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-unnecessary-virtual-specifier -Wno-suggest-destructor-override -Wno-ms-bitfield-padding}
+# QcomXnuUsbDebug: the six patched XNU units (pexpert/arm/pe_kprintf.c,
+# osfmk/kern/debug.c, osfmk/kern/printf.c, osfmk/console/serial_console.c,
+# osfmk/console/serial_general.c, bsd/kern/bsd_init.c) each guard their hooks
+# with #if XNU_QCOM_USB_DEBUG.  EXTRA_CFLAGS reaches every unit and is safe
+# because only those six include QcomXnuUsbDebug.h.
+QCOM_XNU_USB_DEBUG=${XNU_QCOM_USB_DEBUG:-0}
+if [ "$QCOM_XNU_USB_DEBUG" != 0 ] && [ "$QCOM_XNU_USB_DEBUG" != 1 ]; then
+  echo 'XNU_QCOM_USB_DEBUG must be 0 or 1' >&2
+  exit 1
+fi
+if [ "$QCOM_XNU_USB_DEBUG" = 1 ]; then
+  QCOM_XNU_USB_DEBUG_INCLUDE=$ROOT/scripts/qcom-xnu-usb-debug/include
+  if [ ! -d "$QCOM_XNU_USB_DEBUG_INCLUDE" ]; then
+    echo "XNU_QCOM_USB_DEBUG=1 but $QCOM_XNU_USB_DEBUG_INCLUDE is missing" >&2
+    exit 1
+  fi
+  EXTRA_CFLAGS="$EXTRA_CFLAGS -DXNU_QCOM_USB_DEBUG=1 -I$QCOM_XNU_USB_DEBUG_INCLUDE"
+fi
 OWNER_ROOT_PROBE=${XNU_VERIFIED_ROOT_PROBE:-0}
 if [ "$OWNER_ROOT_PROBE" != 0 ] && [ "$OWNER_ROOT_PROBE" != 1 ]; then
   echo 'XNU_VERIFIED_ROOT_PROBE must be 0 or 1' >&2
@@ -770,6 +788,12 @@ PY_BINDINGS
     KERNEL_EXTRA_ARCHIVES="$KERNEL_EXTRA_ARCHIVES -Wl,-force_load,$PMGR_ARCHIVE"
     KERNEL_ARCHIVE_DEPENDENCIES="$KERNEL_ARCHIVE_DEPENDENCIES $PMGR_ARCHIVE"
   fi
+  if [ "$QCOM_XNU_USB_DEBUG" = 1 ]; then
+    QCOM_XNU_USB_DEBUG_ARCHIVE=$ROOT/build/qcom-xnu-usb-debug/libQcomXnuUsbDebug.a
+    test -f "$QCOM_XNU_USB_DEBUG_ARCHIVE"
+    KERNEL_EXTRA_ARCHIVES="$KERNEL_EXTRA_ARCHIVES -Wl,-force_load,$QCOM_XNU_USB_DEBUG_ARCHIVE"
+    KERNEL_ARCHIVE_DEPENDENCIES="$KERNEL_ARCHIVE_DEPENDENCIES $QCOM_XNU_USB_DEBUG_ARCHIVE"
+  fi
   # Optional extra link inputs (e.g. a stub for an unselected offline probe hook).
   if [ "$BOOT_PROGRESS" = 1 ]; then
     KERNEL_EXTRA_ARCHIVES="$KERNEL_EXTRA_ARCHIVES -Wl,-force_load,$ROOT/build/boot-progress/libBootProgress.a"
